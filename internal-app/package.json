  "dependencies": {
    "@clerk/backend": "^3.16.10",
    "@clerk/nextjs": "^7.0.0",
    "next": "^16.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-server-dom-webpack": "^19.2.6",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@cloudflare/workers-types": "latest",
    "@vinext/cloudflare": "latest",
    "@vitejs/plugin-rsc": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}
