{
  "name": "vetwel-internal-ai",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:cloudflare": "vinext check",
    "dev:cloudflare": "vinext dev",
    "build:cloudflare": "npm install --include=dev --no-audit --no-fund && vinext build",
    "deploy:cloudflare": "vinext build && npx @vinext/cloudflare deploy --skip-build"
