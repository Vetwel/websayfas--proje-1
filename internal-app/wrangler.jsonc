{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vetwel-internal-ai",
  "account_id": "72994666ab50ebd44473f30ce7c9c054",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "vinext/server/app-router-entry",
  "preview_urls": true,
  "routes": [
    {
      "pattern": "internal.vetwel.us",
      "custom_domain": true,
      "zone_name": "vetwel.us"
    }
  ],
  "assets": {
    "not_found_handling": "none"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  }
}
