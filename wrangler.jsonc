{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vetwel-ai",
  "main": "./_worker.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "VETWEL_AI_MODEL": "@cf/zai-org/glm-4.7-flash"
  },
  "observability": {
    "enabled": true
  }
}
