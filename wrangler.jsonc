{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vetwel-public-ai",
  "main": "./_worker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "4731",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "vars": {
    "VETWEL_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8"
  },
  "observability": {
    "enabled": true
  }
}
